# Pour le developpement local, aucune variable n'est obligatoire.
# Sans Supabase, l'application utilise data/db.json.

ADMIN_PASSWORD=change-moi

# Option production Vercel + Supabase gratuit
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Envoi email commandes
# Exemple Infomaniak: SMTP_HOST=mail.infomaniak.com, SMTP_PORT=465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ORDER_EMAIL_FROM=
ORDER_TEST_EMAIL=
ORDER_ADMIN_EMAIL=
