# Pour le developpement local, aucune variable n'est obligatoire.
# Sans MySQL ni Supabase, l'application utilise data/db.json.

ADMIN_PASSWORD=change-moi

# Option production Vercel + Supabase gratuit
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Option production Infomaniak MySQL/MariaDB
# Si ces variables sont remplies, MySQL est utilise en priorite.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=5

# Envoi email commandes
# Exemple Infomaniak: SMTP_HOST=mail.infomaniak.com, SMTP_PORT=465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ORDER_EMAIL_FROM=
ORDER_TEST_EMAIL=
ORDER_ADMIN_EMAIL=
